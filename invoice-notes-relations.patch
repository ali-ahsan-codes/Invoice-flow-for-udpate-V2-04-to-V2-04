+def totals_included_clause():
+    """SQL criterion for report totals: excludes invoices whose amount was merged into another
+    invoice with 'exclude from totals' chosen. Use as .filter(totals_included_clause()) on any
+    SUM/COUNT over Invoice where the total must not double count merged amounts."""
+    excluded = (select(InvoiceLink.linked_invoice_id)
+                .where(InvoiceLink.amount_action == 'merge',
+                       InvoiceLink.exclude_from_totals.is_(True)))
+    return Invoice.id.not_in(excluded)
+
+
+def totals_amount_expr():
+    """SUM-able money expression: the invoice amount, or 0 when the invoice is excluded from totals.
+    Use where the same query also needs physical counts (e.g. book page usage) that must stay true."""
+    return case((totals_included_clause(), Invoice.total_amount), else_=0)
