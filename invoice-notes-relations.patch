@@ -0,0 +1,285 @@
+"""Tests for (1) the optional 'exclude from totals' choice on merges, (2) the mobile API for
+notes/links/history, and (3) the upload file-type rules.
+
+Runs through the real Flask app on a temporary SQLite database (sqlite_harness.py).
+Run: python qa/exclusion_and_mobile_api_test.py
+"""
+import io
+import os
+import sys
+from datetime import date
+from decimal import Decimal
+
+sys.path.insert(0, os.path.dirname(__file__))
+import sqlite_harness as h  # noqa: E402
+
+app = h.make_app()
+app.config['TESTING'] = True
+
+from sqlalchemy import func  # noqa: E402
+from app.extensions import db  # noqa: E402
+from app.models import User, Invoice, Batch, InvoiceLink, InvoiceNote, InvoiceNoteMedia, totals_amount_expr  # noqa: E402
+from app.services.invoice_service import get_work_days_summary, get_daily_totals  # noqa: E402
+
+PASSED = []
+TODAY = date(2026, 10, 15)
+PERIOD = (date(2026, 10, 1), date(2026, 10, 31))
+
+
+def check(label, cond, extra=''):
+    if not cond:
+        raise AssertionError(f'FAIL: {label} {extra}')
+    PASSED.append(label)
+    print('PASS', label)
+
+
+def setup_data():
+    with app.app_context():
+        sarah = User(username='sarah', email='sarah@x.test', role='data_entry')
+        sarah.set_password('Sarah@12345')
+        sarah.api_key = 'sarah-key-123'
+        omar = User(username='omar', email='omar@x.test', role='data_entry')
+        omar.set_password('Omar@12345')
+        omar.api_key = 'omar-key-456'
+        admin = User(username='admin', email='admin@x.test', role='admin')
+        admin.set_password('Admin@12345')
+        admin.api_key = 'admin-key-789'
+        db.session.add_all([sarah, omar, admin])
+        db.session.flush()
+        hidden = Batch(id=3, name='Hidden Batch', numbering_mode='repeat', start_book=1,
+                       start_serial=201, archived=False, hidden=True)
+        b2 = Batch(id=2, name='Batch 2', numbering_mode='repeat', start_book=1,
+                   start_serial=101, archived=False)
+        db.session.add_all([b2, hidden])
+        db.session.flush()
+
+        def mk(batch_id, serial, owner, amounts, day=15):
+            i = Invoice(batch_id=batch_id, date=date(2026, 10, day), serial_number=serial,
+                        total_amount=Decimal(str(round(sum(amounts), 3))),
+                        created_by=owner.id, updated_by=owner.id)
+            i.set_amounts(amounts)
+            db.session.add(i)
+            db.session.flush()
+            return i.id
+
+        ids = {
+            'old': mk(1, '0001', sarah, [100.0]),          # past invoice being merged in
+            'new': mk(1, '0002', sarah, [40.0]),           # current invoice receiving the merge
+            'other': mk(1, '0003', sarah, [10.0]),         # unrelated invoice
+            'omar': mk(1, '0004', omar, [5.0]),            # other clerk's invoice
+            'b2': mk(2, '0001', sarah, [50.0], day=16),    # same serial in batch 2 (different date: unique per date)
+            'hidden': mk(3, '0009', sarah, [7.0]),         # in the hidden batch
+        }
+        db.session.commit()
+        return ids
+
+
+def login(client, username, password):
+    r = client.post('/auth/login', data={'username': username, 'password': password})
+    assert r.status_code in (200, 302), r.status_code
+
+
+def period_total():
+    with app.app_context():
+        db.session.expire_all()
+        s = get_work_days_summary(*PERIOD, user_id=None)
+        return round(float(s['total_amount']), 3), s['invoice_count']
+
+
+def raw_sum():
+    with app.app_context():
+        db.session.expire_all()
+        return round(float(db.session.query(func.sum(Invoice.total_amount)).scalar() or 0), 3)
+
+
+def main():
+    ids = setup_data()
+    sarah_c = app.test_client()
+    omar_c = app.test_client()
+    admin_c = app.test_client()
+    login(sarah_c, 'sarah', 'Sarah@12345')
+    login(omar_c, 'omar', 'Omar@12345')
+    login(admin_c, 'admin', 'Admin@12345')
+
+    base_total = 100 + 40 + 10 + 5 + 50 + 7  # everything visible to admin, hidden batch included
+    check('baseline: admin period total counts every invoice',
+          period_total() == (round(base_total, 3), 6), str(period_total()))
+
+    # ---------------- Exclude-from-totals choice ----------------
+    r = sarah_c.post(f"/invoices/{ids['new']}/links?batch_id=1",
+                     data={'linked_serial': '1', 'link_type': 'duplicate', 'amount_action': 'merge',
+                           'exclude_from_totals': '1'},
+                     headers={'X-Requested-With': 'XMLHttpRequest'})
+    check('merge with exclude chosen is accepted', r.status_code == 200 and r.get_json()['success'],
+          r.get_data(as_text=True))
