  CONSTRAINT fk_identity_invoice FOREIGN KEY (invoice_id) REFERENCES invoices(id) ON DELETE CASCADE
 ) ENGINE=InnoDB;
 
+-- Invoice notes/comments, their attachments, and invoice-to-invoice relations.
+CREATE TABLE IF NOT EXISTS invoice_notes (
+ id INTEGER NOT NULL AUTO_INCREMENT,
+ invoice_id INTEGER NOT NULL,
+ body TEXT,
+ created_by INTEGER NOT NULL,
+ created_at DATETIME,
+ PRIMARY KEY (id),
+ INDEX ix_invoice_notes_invoice_id (invoice_id),
+ INDEX ix_invoice_notes_created_at (created_at),
+ FOREIGN KEY(invoice_id) REFERENCES invoices (id) ON DELETE CASCADE,
+ FOREIGN KEY(created_by) REFERENCES users (id)
+) ENGINE=InnoDB;
+
+CREATE TABLE IF NOT EXISTS invoice_note_media (
+ id INTEGER NOT NULL AUTO_INCREMENT,
+ note_id INTEGER NOT NULL,
+ file_name VARCHAR(255) NOT NULL,
+ file_path VARCHAR(500) NOT NULL,
+ file_size INTEGER NOT NULL,
+ mime_type VARCHAR(100) NOT NULL,
+ uploaded_by INTEGER NOT NULL,
+ uploaded_at DATETIME,
+ PRIMARY KEY (id),
+ INDEX ix_invoice_note_media_note_id (note_id),
+ FOREIGN KEY(note_id) REFERENCES invoice_notes (id) ON DELETE CASCADE,
+ FOREIGN KEY(uploaded_by) REFERENCES users (id)
+) ENGINE=InnoDB;
+
+CREATE TABLE IF NOT EXISTS invoice_links (
+ id INTEGER NOT NULL AUTO_INCREMENT,
+ invoice_id INTEGER NOT NULL,
+ linked_invoice_id INTEGER NOT NULL,
+ link_type VARCHAR(20) NOT NULL,
+ amount_action VARCHAR(10) NOT NULL,
+ merged_amount NUMERIC(10, 3),
+ merged_line_index INTEGER,
+ note TEXT,
+ created_by INTEGER NOT NULL,
+ created_at DATETIME,
+ PRIMARY KEY (id),
+ CONSTRAINT uq_invoice_link_pair UNIQUE (invoice_id, linked_invoice_id),
+ CONSTRAINT ck_invoice_link_distinct CHECK (invoice_id <> linked_invoice_id),
+ INDEX ix_invoice_links_invoice_id (invoice_id),
+ INDEX ix_invoice_links_linked_invoice_id (linked_invoice_id),
+ INDEX ix_invoice_links_created_at (created_at),
+ FOREIGN KEY(invoice_id) REFERENCES invoices (id) ON DELETE CASCADE,
+ FOREIGN KEY(linked_invoice_id) REFERENCES invoices (id) ON DELETE CASCADE,
+ FOREIGN KEY(created_by) REFERENCES users (id)
+) ENGINE=InnoDB;
+
 -- IMPORTANT: run the offline Python schema upgrade to install and verify
 -- invoices_reserve_ai and invoices_reserve_au BEFORE opening entry.
 
