+"""Scenario tests for invoice notes/attachments, relations and merged amounts.
+
+Runs through the real Flask routes (test client). Runs on a temporary SQLite database via
+sqlite_harness.py (no MySQL needed). Run: python qa/invoice_history_test.py
+"""
+import io
+import json
+import os
+import sys
+from datetime import date
+from decimal import Decimal
+
+sys.path.insert(0, os.path.dirname(__file__))
+import sqlite_harness as h  # noqa: E402
+
+app = h.make_app()
+app.config['TESTING'] = True
+
+from app.extensions import db  # noqa: E402
+from app.models import User, Invoice, InvoiceNote, InvoiceNoteMedia, InvoiceLink, AuditLog  # noqa: E402
+
+PASSED = []
+
+
+def check(label, cond, extra=''):
+    if not cond:
+        raise AssertionError(f'FAIL: {label} {extra}')
+    PASSED.append(label)
+    print('PASS', label)
+
+
+def setup_data():
+    with app.app_context():
+        admin = User(username='admin', email='admin@x.test', role='admin')
+        admin.set_password('Admin@12345')
+        sarah = User(username='sarah', email='sarah@x.test', role='data_entry')
+        sarah.set_password('Sarah@12345')
+        omar = User(username='omar', email='omar@x.test', role='data_entry')
+        omar.set_password('Omar@12345')
+        db.session.add_all([admin, sarah, omar])
+        db.session.flush()
+
+        def inv(serial, owner, amounts):
+            i = Invoice(batch_id=1, date=date(2026, 10, 1), serial_number=serial,
+                        total_amount=Decimal(str(round(sum(amounts), 3))),
+                        created_by=owner.id, updated_by=owner.id)
+            i.set_amounts(amounts)
+            db.session.add(i)
+            db.session.flush()
+            return i.id
+
+        ids = {
+            'i1': inv('0001', sarah, [10.0, 5.5]),
+            'i2': inv('0002', sarah, [20.0]),
+            'i3': inv('0003', omar, [7.0]),
+            'i4': inv('0004', sarah, [3.0]),
+        }
+        db.session.commit()
+        return ids
+
+
+def login(client, username, password):
+    r = client.post('/auth/login', data={'username': username, 'password': password})
+    assert r.status_code in (200, 302), r.status_code
+
+
+def load(inv_id):
+    with app.app_context():
+        db.session.expire_all()
+        i = db.session.get(Invoice, inv_id)
+        return i.get_amounts(), float(i.total_amount)
+
+
+def upload_dir():
+    return app.config['UPLOAD_FOLDER']
+
+
+def main():
+    ids = setup_data()
+    i1, i2, i3, i4 = ids['i1'], ids['i2'], ids['i3'], ids['i4']
