diff -ruN orig/invoiceflow-server/server/qa/sqlite_harness.py invoiceflow-server/server/qa/sqlite_harness.py
--- orig/invoiceflow-server/server/qa/sqlite_harness.py	1970-01-01 00:00:00.000000000 +0000
+++ invoiceflow-server/server/qa/sqlite_harness.py	2026-10-17 15:08:14.086214688 +0000
@@ -0,0 +1,69 @@
+"""Local test harness ONLY: runs the app on SQLite when no MySQL server is available.
+
+Runs the real app code against SQLite. Patches just the MySQL-only startup gates
+(URL validation and information_schema / trigger verification). Never used for production.
+"""
+import os
+import re
+import sys
+import tempfile
+
+SERVER = os.environ.get('SERVER_DIR') or os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
+sys.path.insert(0, SERVER)
+os.chdir(SERVER)
+
+import app.startup as startup  # noqa: E402
+import app.utils.db_utils as db_utils  # noqa: E402
+
+startup.validate_settings = lambda settings: None
+
+
+def _create_and_seed():
+    """Stands in for verify_schema(): create tables and seed the rows the app expects."""
+    from app.extensions import db
+    from app.models import Batch
+    from app.detection import DetectionPolicy
+    from app.realtime import LiveRevision
+    db.create_all()
+    if not db.session.get(Batch, 1):
+        db.session.add(Batch(id=1, name='Batch 1', numbering_mode='repeat',
+                             start_book=1, start_serial=1, archived=False))
+    if not db.session.get(DetectionPolicy, 1):
+        db.session.add(DetectionPolicy(id=1, manual_enabled=True, automatic_enabled=True, version=1))
+    if not db.session.get(LiveRevision, 1):
+        db.session.add(LiveRevision(id=1, token='x' * 32))
+    db.session.commit()
+
+
+db_utils.verify_schema = _create_and_seed
+
+from sqlalchemy import event  # noqa: E402
+from sqlalchemy.engine import Engine  # noqa: E402
+from config import Config  # noqa: E402
+
+TMP = tempfile.mkdtemp(prefix='ifh_')
+
+
+@event.listens_for(Engine, 'connect')
+def _sqlite_regexp(dbapi_conn, _rec):
+    if type(dbapi_conn).__module__.startswith('sqlite3'):
+        dbapi_conn.create_function(
+            'regexp', 2,
+            lambda pat, val: 1 if val is not None and re.search(pat, str(val)) else 0)
+
+
+class TestCfg(Config):
+    SQLALCHEMY_DATABASE_URI = 'sqlite:///' + os.path.join(TMP, 'test.db')
+    SQLALCHEMY_ENGINE_OPTIONS = {}
+    SECRET_KEY = 'test-secret-key-for-local-harness-only-123456'
+    SCHEDULER_ENABLED = False
+    TESTING = True
+    WTF_CSRF_ENABLED = False
+    UPLOAD_FOLDER = os.path.join(TMP, 'uploads')
+    BACKUP_DIR = os.path.join(TMP, 'backups')
+    SESSION_COOKIE_SECURE = False
+
+
+def make_app():
+    from app import create_app
+    return create_app(TestCfg)
diff -ruN orig/invoiceflow-server/server/sql/new_database_schema.sql invoiceflow-server/server/sql/new_database_schema.sql
