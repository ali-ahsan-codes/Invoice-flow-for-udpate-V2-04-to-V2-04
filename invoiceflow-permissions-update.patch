+def capability_required(cap):
+    """
+    Allow the request only if the logged-in user has capability `cap`.
+    Admins always pass. Data-entry users need an allow from the admin (see app/permissions.py).
+    AJAX/JSON callers get a 403 JSON body; normal page requests get a flash and a redirect back.
+    """
+    def decorator(f):
+        @wraps(f)
+        def decorated_function(*args, **kwargs):
+            if not current_user.is_authenticated:
+                if request.headers.get('X-Requested-With') == 'XMLHttpRequest' or request.headers.get('X-Live-Sync') == '1':
+                    return jsonify(success=False, error='Please sign in again.'), 401
+                flash('Please log in to access this page.', 'warning')
+                return redirect(url_for('auth.login'))
+            if not user_can(current_user, cap):
+                message = DENIED_MESSAGE.format(label=capability_label(cap))
+                if request.headers.get('X-Requested-With') == 'XMLHttpRequest' or request.headers.get('X-Live-Sync') == '1' \
+                        or request.accept_mimetypes.accept_json:
+                    return jsonify(success=False, error=message, capability=cap), 403
+                flash(message, 'danger')
+                return redirect(request.referrer or url_for('main.dashboard'))
+            return f(*args, **kwargs)
+        return decorated_function
+    return decorator
