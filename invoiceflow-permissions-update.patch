+{% extends "base.html" %}
+
+{% block title %}Permissions: {{ user.username }} - InvoiceFlow v2{% endblock %}
+
+{% block head_extra %}
+<style>
+    .perm-group { background: #fff; border: 1px solid #e9ecef; border-radius: 8px; margin-bottom: 1rem; }
+    .perm-group h6 { margin: 0; padding: .75rem 1rem; background: #f8fafc; border-bottom: 1px solid #e9ecef; font-weight: 700; }
+    .perm-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid #f1f3f5; }
+    .perm-row:last-child { border-bottom: 0; }
+    .perm-row .perm-desc { color: #6c757d; font-size: .85rem; }
+    .perm-badge { font-size: .7rem; }
+    .form-check-input.perm-switch { width: 2.6em; height: 1.3em; cursor: pointer; }
+</style>
+{% endblock %}
+
+{% block content %}
+<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
+    <div>
+        <h4 class="mb-0"><i class="fas fa-user-shield me-2"></i>Permissions for {{ user.username }}</h4>
+        <small class="text-muted">Choose what this user can do. Changes apply on their next request, including the mobile app.</small>
+    </div>
+    <a href="{{ url_for('admin.users') }}" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to users</a>
+</div>
+
+<div class="alert alert-light border small">
+    <strong>{{ explicit_count }}</strong> of {{ total }} permissions are set by the admin. The rest use the default (allowed).
+    Admins always have every permission.
+</div>
+
+<form method="POST" action="{{ url_for('admin.user_permissions', id=user.id) }}" id="permissions-form">
+    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+
+    {% for group_name, items in groups %}
+    <div class="perm-group">
+        <h6>{{ group_name }}</h6>
+        {% for item in items %}
+        <div class="perm-row">
+            <div>
+                <label class="fw-semibold" for="cap_{{ item.key }}">{{ item.label }}</label>
+                {% if item.explicit %}<span class="badge bg-primary perm-badge ms-1">Set by admin</span>{% else %}<span class="badge bg-light text-secondary border perm-badge ms-1">Default</span>{% endif %}
+                <div class="perm-desc">{{ item.description }}</div>
+                <div class="perm-desc"><code>{{ item.key }}</code></div>
+            </div>
+            <div class="form-check form-switch m-0">
+                <input class="form-check-input perm-switch" type="checkbox" role="switch" id="cap_{{ item.key }}" name="cap_{{ item.key }}" {% if item.allowed %}checked{% endif %}>
+            </div>
+        </div>
+        {% endfor %}
+    </div>
+    {% endfor %}
+
+    <div class="d-flex flex-wrap gap-2 mt-3">
+        <button type="submit" name="preset" value="custom" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save permissions</button>
+        <button type="submit" name="preset" value="all" class="btn btn-outline-success" onclick="return confirm('Allow every function for this user?')">Allow all</button>
+        <button type="submit" name="preset" value="none" class="btn btn-outline-danger" onclick="return confirm('Turn off every function for this user? They can still sign in and view invoices.')">Turn off all</button>
+        <button type="submit" name="preset" value="default" class="btn btn-outline-secondary ms-auto" onclick="return confirm('Remove all custom settings and use the defaults?')">Reset to defaults</button>
+    </div>
+</form>
+{% endblock %}
