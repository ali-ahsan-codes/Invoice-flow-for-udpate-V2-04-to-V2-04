+@bp.route('/link-lookup')
+@data_entry_required
+def link_lookup():
+    """Live preview for the link form: what invoice does this batch + serial point to?
+
+    Query: batch_id, serial, current (id of the invoice being viewed). Only invoices the
+    current user may access are returned, so the preview never leaks hidden data.
+    """
+    serial = (request.args.get('serial') or '').strip().lstrip('#').strip()
+    if not serial:
+        return jsonify(found=False, message='')
+    try:
+        batch_id = int(request.args.get('batch_id') or 0) or None
+    except ValueError:
+        return jsonify(found=False, message='Choose a valid batch.'), 400
+    if batch_id is None:
+        batch_id = current_batch_id()
+
+    inv = get_accessible_invoice_by_serial(batch_id, serial, current_user)
+    if not inv:
+        return jsonify(found=False,
+                       message=f'No invoice {serial} in that batch is available to you.')
+    if str(inv.id) == (request.args.get('current') or ''):
+        return jsonify(found=False, message='That is this invoice. Choose a different one.')
+
+    book, page = get_invoice_book_page(inv)
+    return jsonify(found=True, invoice={
+        'id': inv.id,
+        'batch_id': inv.batch_id,
+        'batch_name': inv.batch.name if inv.batch else '',
+        'serial_number': inv.serial_number,
+        'date': inv.date.isoformat() if inv.date else '',
+        'book': book,
+        'page': page,
+        'total_amount': float(inv.total_amount or 0),
+        'amounts': inv.get_amounts(),
+        'created_by': inv.creator.username if inv.creator else None,
+    })
+
